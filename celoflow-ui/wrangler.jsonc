{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "celoflow",
  "compatibility_date": "2026-01-19",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "pages_build_output_dir": "dist",
  "observability": {
    "enabled": true
  },
  "env": {
    "preview": {
      "compatibility_date": "2026-01-19",
      "compatibility_flags": [
        "nodejs_compat",
        "nodejs_als"
      ]
    },
    "production": {
      "compatibility_date": "2026-01-19",
      "compatibility_flags": [
        "nodejs_compat",
        "nodejs_als"
      ]
    }
  }
}
