    "viem": "^2.46.1",
    "wagmi": "^3.4.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^25.2.3",
    "@vitejs/plugin-react": "^5.1.4",
